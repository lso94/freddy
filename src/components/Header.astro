          </a>
          <a href="https://www.facebook.com/k1andorragym" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@freddy_coach_boxing" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        </div>
      </div>

      <!-- Iconos sociales en barra desktop -->
      <div class="header-social">
        <a href="https://www.instagram.com/k1andorra/" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.facebook.com/k1andorragym" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@freddy_coach_boxing" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
      </div>

      <button class="mobile-menu-toggle" aria-label="Menú">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    transition: all 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(11, 13, 15, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(225, 6, 0, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .site-header.scrolled::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.3;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
  }

  .logo img {
    height: 90px;
    width: auto;
    filter: drop-shadow(0 2px 8px rgba(225, 6, 0, 0.4));
    transition: all 0.3s ease;
  }

  .logo:hover img {
    filter: drop-shadow(0 4px 12px rgba(225, 6, 0, 0.6));
    transform: translateY(-2px);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    flex: 1;
    justify-content: flex-end;
  }

  .nav-link {
    font-family: 'Oswald', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(246, 247, 249, 0.9);
    transition: all 0.3s ease;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: var(--accent);
    text-shadow: 0 0 8px rgba(225, 6, 0, 0.4);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-item-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .dropdown-arrow {
    font-size: 0.6rem;
    margin-left: 0.4rem;
    transition: transform 0.3s ease;
    display: inline-block;
  }

  .nav-item-dropdown:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: rgba(11, 13, 15, 0.98);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(225, 6, 0, 0.2);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    padding: 0.5rem 0;
    margin-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
  }

  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--gold));
  }

  .nav-item-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.75rem 1.5rem;
    font-family: 'Oswald', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(246, 247, 249, 0.85);
    transition: all 0.2s ease;
    position: relative;
  }

  .dropdown-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .dropdown-link:hover {
    color: var(--accent);
    background: rgba(225, 6, 0, 0.05);
    padding-left: 2rem;
  }

  .dropdown-link:hover::before {
    width: 1rem;
    left: 0.5rem;
  }

  /* Iconos sociales — desktop */
  .header-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 1rem;
    border-left: 1px solid rgba(246, 247, 249, 0.15);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: rgba(246, 247, 249, 0.7);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
  }

  .social-icon:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Iconos sociales — menú móvil */
  .nav-social {
    display: none;
    gap: 1.25rem;
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    border-top: 1px solid rgba(246, 247, 249, 0.1);
  }

  .nav-social .social-icon svg {
    width: 22px;
    height: 22px;
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--fg);
    transition: all 0.3s ease;
  }

  @media (max-width: 1024px) {
    .logo img {
      height: 65px;
    }

    /* En móvil: ocultar barra desktop, mostrar en menú */
    .header-social {
      display: none;
    }

    .nav-social {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 105px;
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(11, 13, 15, 0.98);
      backdrop-filter: blur(20px) saturate(180%);
      padding: 2rem;
      gap: 1.5rem;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      border-top: 1px solid rgba(225, 6, 0, 0.2);
      max-height: calc(100vh - 105px);
      overflow-y: auto;
      z-index: 999;
    }

    .nav-links.active {
      transform: translateX(0);
      display: flex;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .mobile-menu-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-menu-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
    }

    .nav-item-dropdown {
      width: 100%;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      margin-top: 0.5rem;
      display: none;
    }

    .nav-item-dropdown.active .dropdown-menu {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .logo img {
      height: 52px;
    }

    .nav-links {
      top: 90px;
      max-height: calc(100vh - 90px);
    }

    .nav {
      padding: 1rem 0;
    }
  }

</style>

<script>
  const header = document.querySelector('.site-header');
  const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  const dropdownItems = document.querySelectorAll('.nav-item-dropdown');

  function handleScroll() {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }

  // Toggle mobile menu
  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenuToggle.classList.toggle('active');
    navLinks?.classList.toggle('active');
    document.body.style.overflow = navLinks?.classList.contains('active') ? 'hidden' : '';
  });

  // Handle dropdown in mobile
  dropdownItems.forEach(item => {
    const link = item.querySelector('.nav-link');
    link?.addEventListener('click', (e) => {
      if (window.innerWidth <= 1024) {
        e.preventDefault();
        item.classList.toggle('active');
      }
    });
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (window.innerWidth <= 1024 && navLinks?.classList.contains('active')) {
      const target = e.target as HTMLElement;
      if (!target.closest('.nav') && !target.closest('.mobile-menu-toggle')) {
        mobileMenuToggle?.classList.remove('active');
        navLinks?.classList.remove('active');
        document.body.style.overflow = '';
      }
    }
  });

  window.addEventListener('scroll', handleScroll);
  handleScroll(); // Check initial state
</script>
