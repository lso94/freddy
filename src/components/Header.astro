---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo-nuevo.png';

const navLinks = [
  { text: 'SOBRE MÍ', href: '/sobre-mi/' },
  {
    text: 'DISCIPLINAS',
    href: '/disciplinas/',
    submenu: [
      { text: 'Boxeo', href: '/disciplinas/boxeo/' },
      { text: 'Kickboxing', href: '/disciplinas/kickboxing/' },
      { text: 'Muay Thai', href: '/disciplinas/muay-thai/' }
    ]
  },
  { text: 'HORARIOS Y PRECIOS', href: '/horarios-precios/' },
  { text: 'GALERÍA', href: '/galeria/' },
  { text: 'CONTACTO', href: '/contacto/' }
];
---

<header class="site-header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <Image src={logoImg} alt="Club K-1 Andorra - Boxeo, Kickboxing y Muay Thai" width={320} height={278} />
      </a>

      <div class="nav-links">
        {navLinks.map(link => (
          link.submenu ? (
            <div class="nav-item-dropdown">
              <a href={link.href} class="nav-link">
                {link.text}
                <span class="dropdown-arrow">▼</span>
              </a>
              <div class="dropdown-menu">
                {link.submenu.map(sublink => (
                  <a href={sublink.href} class="dropdown-link">{sublink.text}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} class="nav-link">{link.text}</a>
          )
        ))}

        <!-- Iconos sociales en menú móvil -->
        <div class="nav-social">
          <a href="https://www.instagram.com/k1andorra/" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
