---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { Image } from 'astro:assets';

// Importar imágenes
import heroImg from '../assets/images/image00007-scaled.jpeg';
import kickImg from '../assets/images/11A_00015.jpeg';
import combatImg1 from '../assets/images/IMG_1657-scaled.jpeg';
import combatImg2 from '../assets/images/IMG_2011_kick-andorra_fin-scaled.jpeg';
import functionalImg from '../assets/images/13007147_1626683194318652_6297385222729411090_n.jpeg';

const title = 'Sobre mí – Alfred "Freddy" Calero | Campeón de Europa | Club K-1 Andorra';
const description = 'Más de 30 años de experiencia en deportes de contacto. Campeón de Europa y España. Entrenador profesional de boxeo, kickboxing y muay thai en Andorra la Vella.';
---

<BaseLayout title={title} description={description} canonical="https://freddyboxing.com/sobre-mi/">
  <Header />
  <WhatsAppButton />

  <main class="warrior-page">
    <!-- Hero Cinematográfico -->
    <section class="warrior-hero">
      <div class="hero-bg"></div>
      <div class="smoke-overlay"></div>

      <div class="hero-warrior-content">
        <div class="warrior-image-container">
          <div class="battle-scars"></div>
          <Image src={heroImg} alt="Alfred Freddy Calero - Guerrero del Ring" width={600} height={900} class="warrior-portrait" />
          <div class="warrior-glow"></div>
        </div>

        <div class="warrior-title-block">
          <span class="warrior-subtitle">EL GUERRERO</span>
          <h1 class="warrior-name">
            <span class="first-name">ALFRED</span>
            <span class="nickname">"FREDDY"</span>
            <span class="last-name">CALERO</span>
          </h1>
          <div class="warrior-stats">
            <div class="stat">
              <span class="stat-number">30+</span>
              <span class="stat-label">Años de Batalla</span>
            </div>
            <div class="stat-divider">|</div>
            <div class="stat">
              <span class="stat-number">∞</span>
              <span class="stat-label">Victorias del Espíritu</span>
            </div>
          </div>
        </div>
      </div>

      <div class="scroll-indicator">
        <span>DESCUBRE LA LEYENDA</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 15L5 10L6.5 8.5L10 12L13.5 8.5L15 10L10 15Z" fill="currentColor"/>
        </svg>
      </div>
    </section>

    <!-- Camino del Guerrero - Timeline -->
    <section class="warrior-path py-5">
      <div class="container">
        <h2 class="section-title">
          <span class="title-line"></span>
          EL CAMINO DEL GUERRERO
          <span class="title-line"></span>
        </h2>

        <div class="path-timeline">
          <!-- Introducción -->
          <div class="timeline-block left">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <span class="timeline-era">INTRODUCCIÓN</span>
              <h3>Soy Alfred "Freddy" Calero</h3>
              <p>Entrenador principal del Club K-1 Andorra. Nací en Andorra en 1972 y llevo más de 30 años vinculado a los deportes de contacto, como competidor y como entrenador.</p>
            </div>
          </div>

          <!-- Inicios -->
          <div class="timeline-block right">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <span class="timeline-era">LOS INICIOS</span>
              <h3>El Judo: La Base</h3>
              <p>Empecé en el judo a los 13 años, donde aprendí valores esenciales como el respeto, la honestidad, el autocontrol y la constancia.</p>
            </div>
          </div>

          <!-- Competición -->
          <div class="timeline-block left">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <span class="timeline-era">COMPETICIÓN</span>
              <h3>Campeón de Europa y España</h3>
              <p>Compití en Kickboxing de forma amateur y profesional, participando en eventos internacionales en diferentes países y obteniendo títulos como:</p>
              <ul style="margin-top: 1rem; padding-left: 1.5rem;">
                <li>Campeón de Cataluña</li>
                <li>Campeón de España</li>
                <li>Campeón de Europa</li>
              </ul>
              <div class="combat-gallery">
                <div class="combat-photo">
                  <Image src={kickImg} alt="Freddy en combate" width={300} height={200} />
                  <span class="photo-caption">En combate</span>
                </div>
                <div class="combat-photo">
                  <Image src={combatImg1} alt="Freddy en el ring" width={300} height={200} />
                  <span class="photo-caption">En el ring</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Muay Thai -->
          <div class="timeline-block right">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <span class="timeline-era">MUAY THAI</span>
              <h3>Viaje a Tailandia</h3>
              <p>Me formé también en Muay Thai, viajando a Tailandia para entrenar y competir, aprendiendo directamente de la cultura que dio origen al arte.</p>
            </div>
          </div>

          <!-- Filosofía -->
          <div class="timeline-block left">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <span class="timeline-era">FILOSOFÍA</span>
              <h3>Un Eterno Aprendiz</h3>
              <p>Me considero un eterno aprendiz. Actualmente mi objetivo es transmitir técnica, cultura deportiva y disciplina a mis alumnos, ya sean principiantes o competidores.</p>
              <div class="combat-gallery">
                <div class="combat-photo wide">
                  <Image src={combatImg2} alt="Entrenamiento en K1 Andorra" width={400} height={250} />
                  <span class="photo-caption">Club K-1 Andorra</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lema -->
    <section class="warrior-philosophy">
      <div class="container">
        <div class="lema-section">
          <h2>Mi Lema</h2>
          <blockquote class="warrior-quote">
            "La constancia crea la superación."
          </blockquote>
          <p class="philosophy-body">
            Esta frase resume mi filosofía de vida y entrenamiento. No importa de dónde partas, sino la dedicación que pongas cada día para mejorar.
          </p>
          <div style="text-align: center; margin-top: 3rem;">
            <a href="/" class="btn">Volver a Inicio</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Arsenal del Guerrero - Disciplinas -->
    <section class="warrior-arsenal py-5">
      <div class="container">
        <h2 class="section-title">
          <span class="title-line"></span>
          EL ARSENAL
          <span class="title-line"></span>
        </h2>

        <div class="arsenal-grid">
          <div class="arsenal-card">
            <div class="arsenal-icon">🥊</div>
            <h3>Boxeo</h3>
            <p>El arte noble. Técnica pura, movimientos precisos. La base de todo guerrero del ring.</p>
          </div>

          <div class="arsenal-card">
            <div class="arsenal-icon">🦵</div>
            <h3>Kickboxing</h3>
            <p>Puños y piernas en perfecta armonía. La evolución del combate moderno.</p>
          </div>

          <div class="arsenal-card">
            <div class="arsenal-icon">⚔️</div>
            <h3>Muay Thai</h3>
            <p>Las 8 armas. El arte milenario tailandés en su máxima expresión.</p>
          </div>

          <div class="arsenal-card">
            <div class="arsenal-icon">🛡️</div>
            <h3>Krav Maga</h3>
            <p>Defensa personal real. Sin reglas, solo supervivencia y eficacia.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .warrior-page {
    background: var(--bg);
    overflow-x: hidden;
  }

  /* Hero Cinematográfico */
  .warrior-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 50%, rgba(225, 6, 0, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 70% 50%, rgba(205, 164, 52, 0.1) 0%, transparent 50%),
      linear-gradient(135deg, #0B0D0F 0%, #14171A 100%);
  }

  .smoke-overlay {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse at 20% 80%, rgba(225, 6, 0, 0.1) 0%, transparent 40%),
      radial-gradient(ellipse at 80% 20%, rgba(205, 164, 52, 0.08) 0%, transparent 40%);
    animation: smokeFloat 8s ease-in-out infinite;
  }

  @keyframes smokeFloat {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 0.6; transform: translateY(-20px); }
  }

  .hero-warrior-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4rem;
    max-width: 1400px;
    padding: 2rem;
  }

  .warrior-image-container {
    position: relative;
    flex-shrink: 0;
  }

  .battle-scars {
    position: absolute;
    top: -20px;
    left: -20px;
    right: -20px;
    bottom: -20px;
    border: 3px solid var(--gold);
    opacity: 0.3;
    clip-path: polygon(
      0 10%, 10% 0, 90% 0, 100% 10%,
      100% 90%, 90% 100%, 10% 100%, 0 90%
    );
  }

  .warrior-portrait {
    width: 400px;
    height: auto;
    filter: grayscale(100%) contrast(1.2);
    clip-path: polygon(
      5% 0, 95% 0, 100% 5%,
      100% 95%, 95% 100%, 5% 100%,
      0 95%, 0 5%
    );
    box-shadow:
      0 0 60px rgba(225, 6, 0, 0.5),
      inset 0 0 100px rgba(225, 6, 0, 0.2);
  }

  .warrior-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(225, 6, 0, 0.3) 0%, transparent 60%);
    mix-blend-mode: screen;
    animation: glowPulse 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .warrior-title-block {
    flex: 1;
    text-align: left;
  }

  .warrior-subtitle {
    display: block;
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--gold);
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(205, 164, 52, 0.6);
  }

  .warrior-name {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .warrior-name span {
    font-family: 'Oswald', sans-serif;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .first-name {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--fg);
    text-shadow: 4px 4px 0 rgba(225, 6, 0, 0.3);
  }

  .nickname {
    font-size: clamp(2rem, 6vw, 4rem);
    color: var(--accent);
    font-style: italic;
    margin-left: 2rem;
    text-shadow: 0 0 30px rgba(225, 6, 0, 0.8);
  }

  .last-name {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--fg);
    text-shadow: 4px 4px 0 rgba(205, 164, 52, 0.3);
  }

  .warrior-stats {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: 'Oswald', sans-serif;
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    font-size: 3rem;
    color: var(--line);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    animation: bounce 2s infinite;
    z-index: 10;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
  }

  /* Timeline del Camino del Guerrero */
  .warrior-path {
    background: var(--bg);
    position: relative;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: 0.15em;
    color: var(--fg);
    margin-bottom: 4rem;
    text-align: center;
  }

  .title-line {
    flex: 1;
    max-width: 200px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .path-timeline {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .path-timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg,
      var(--accent) 0%,
      var(--gold) 50%,
      var(--accent) 100%
    );
    transform: translateX(-50%);
  }

  .timeline-block {
    position: relative;
    margin-bottom: 4rem;
    width: 50%;
  }

  .timeline-block.left {
    padding-right: 4rem;
    text-align: right;
  }

  .timeline-block.right {
    margin-left: 50%;
    padding-left: 4rem;
  }

  .timeline-marker {
    position: absolute;
    top: 0;
    width: 30px;
    height: 30px;
    background: var(--accent);
    border: 5px solid var(--bg);
    border-radius: 50%;
    box-shadow: 0 0 20px rgba(225, 6, 0, 0.8);
  }

  .timeline-block.left .timeline-marker {
    right: -15px;
  }

  .timeline-block.right .timeline-marker {
    left: -15px;
  }

  .timeline-content {
    background: var(--card);
    padding: 2rem;
    border: 1px solid var(--line);
    position: relative;
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    border-color: var(--gold);
    box-shadow: 0 10px 40px rgba(205, 164, 52, 0.2);
    transform: translateY(-5px);
  }

  .timeline-era {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: var(--gold);
    background: rgba(205, 164, 52, 0.1);
    padding: 0.5rem 1rem;
    margin-bottom: 1rem;
    border-left: 3px solid var(--accent);
  }

  .timeline-content h3 {
    color: var(--fg);
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .timeline-content p {
    color: rgba(246, 247, 249, 0.8);
    line-height: 1.8;
  }

  .combat-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .combat-gallery .wide {
    grid-column: 1 / -1;
  }

  .combat-photo {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--line);
  }

  .combat-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(50%);
    transition: all 0.4s ease;
  }

  .combat-photo:hover img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--gold);
    text-align: center;
  }

  /* Filosofía */
  .warrior-philosophy {
    background: var(--card);
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
  }

  .warrior-philosophy::before {
    content: '';
    position: absolute;
    top: 0;
    left: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(225, 6, 0, 0.08) 0%, transparent 70%);
  }

  .lema-section {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .lema-section h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--accent);
    margin-bottom: 2rem;
  }

  .warrior-quote {
    font-family: Georgia, serif;
    font-size: 2rem;
    font-style: italic;
    color: var(--gold);
    border: none;
    padding: 2rem;
    margin: 2rem 0;
    line-height: 1.6;
    position: relative;
  }

  .warrior-quote::before {
    content: '"';
    font-size: 6rem;
    position: absolute;
    top: -2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(205, 164, 52, 0.2);
    font-family: Georgia, serif;
  }

  .philosophy-body {
    font-size: 1.15rem;
    line-height: 1.8;
    color: rgba(246, 247, 249, 0.9);
    margin-bottom: 1.5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Arsenal */
  .warrior-arsenal {
    background: var(--bg);
  }

  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .arsenal-card {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 2.5rem 1.5rem;
    text-align: center;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .arsenal-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(225, 6, 0, 0.05), rgba(205, 164, 52, 0.05));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .arsenal-card:hover::before {
    opacity: 1;
  }

  .arsenal-card:hover {
    border-color: var(--gold);
    transform: translateY(-10px);
    box-shadow: 0 20px 60px rgba(205, 164, 52, 0.3);
  }

  .arsenal-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    filter: grayscale(100%);
    opacity: 0.8;
    transition: all 0.4s ease;
  }

  .arsenal-card:hover .arsenal-icon {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.2);
  }

  .arsenal-card h3 {
    color: var(--fg);
    margin-bottom: 1rem;
  }

  .arsenal-card p {
    color: rgba(246, 247, 249, 0.8);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* CTA Épico */
  .warrior-cta {
    background:
      linear-gradient(135deg, rgba(225, 6, 0, 0.1) 0%, rgba(11, 13, 15, 0.95) 50%, rgba(205, 164, 52, 0.1) 100%),
      url('/src/assets/images/11A_00015.jpeg') center/cover;
    padding: 8rem 0;
    text-align: center;
    position: relative;
  }

  .warrior-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(11, 13, 15, 0.85);
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--fg);
    margin-bottom: 1.5rem;
    text-shadow: 2px 2px 0 var(--accent);
  }

  .cta-content p {
    font-size: 1.25rem;
    color: rgba(246, 247, 249, 0.9);
    margin-bottom: 3rem;
    line-height: 1.8;
  }

  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-epic {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 1.5rem 3rem;
    background: var(--accent);
    color: var(--fg);
    border: 2px solid var(--accent);
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(225, 6, 0, 0.4);
  }

  .btn-epic:hover {
    background: transparent;
    color: var(--accent);
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(225, 6, 0, 0.6);
  }

  .btn-epic.outline {
    background: transparent;
    border-color: var(--gold);
    color: var(--gold);
    box-shadow: 0 10px 30px rgba(205, 164, 52, 0.3);
  }

  .btn-epic.outline:hover {
    background: var(--gold);
    color: var(--bg);
    box-shadow: 0 15px 40px rgba(205, 164, 52, 0.5);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .warrior-hero {
      min-height: 100vh;
      padding: 6rem 1rem 4rem;
    }

    .hero-warrior-content {
      flex-direction: column;
      text-align: center;
      gap: 3rem;
      padding: 2rem 1rem;
    }

    .warrior-image-container {
      max-width: 100%;
      margin: 0 auto;
    }

    .warrior-title-block {
      text-align: center;
      max-width: 100%;
    }

    .warrior-name {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .warrior-portrait {
      width: 100%;
      max-width: 350px;
      height: auto;
    }

    .warrior-stats {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .stat-number {
      font-size: 2.5rem;
    }

    .timeline-block,
    .timeline-block.left,
    .timeline-block.right {
      width: 100%;
      margin-left: 0;
      padding-left: 4rem;
      padding-right: 1rem;
      text-align: left;
    }

    .path-timeline::before {
      left: 15px;
    }

    .timeline-marker {
      left: 0 !important;
      right: auto !important;
    }

    .lema-section {
