---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import { Image } from 'astro:assets';

// Importar imágenes
import heroImg from '../assets/images/COPIA-SLIDER-scaled.jpeg';
import trainerImg from '../assets/images/2.png';
import boxingImg from '../assets/images/IMG_2011_kick-andorra_fin-scaled.jpeg';
import kickImg from '../assets/images/11A_00015.jpeg';
import muaythaiImg from '../assets/images/IMG_1657-scaled.jpeg';
import testimonio1Img from '../assets/images/unnamed.png';
import testimonio2Img from '../assets/images/unnamed-1.png';
import testimonio3Img from '../assets/images/Captura-de-pantalla-2024-06-24-193839.png';

const title = 'Club K-1 Andorra – Boxeo, Kickboxing y Muay Thai en Andorra la Vella';
const description = 'Entrenamientos de Boxeo, Kickboxing y Muay Thai para todos los niveles en Andorra la Vella. Ponte en forma, aprende técnica y supera tus límites en un ambiente profesional y motivador.';
---

<BaseLayout title={title} description={description} canonical="https://k-1andorra.com/">
  <IntroAnimation />
  <Header />
  <WhatsAppButton />

  <main>
    <!-- Hero Section con animación de texto -->
    <section class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <h1>Club K-1 Andorra</h1>
        <p class="hero-subtitle">Boxeo, Kickboxing y Muay Thai en Andorra la Vella</p>

        <!-- Frase motivacional de Freddy -->
        <div class="hero-phrase" aria-hidden="true">
          <span class="phrase-part active" data-part="1">SIN SACRIFICIO</span>
          <span class="phrase-part" data-part="2">NO HAY GLORIA</span>
        </div>

        <p class="hero-tagline">Entrenamientos para todos los niveles. Ponte en forma, aprende técnica y supera tus límites en un ambiente profesional y motivador.</p>
        <div class="hero-actions">
          <a
            href="https://api.whatsapp.com/send?phone=376331785&text=Hola%2C%20quiero%20reservar%20mi%20primera%20clase."
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            Reservar primera clase
          </a>
          <a href="/horarios-precios/" class="btn outline">
            Ver horarios y tarifas
          </a>
        </div>
      </div>

      <!-- Scroll progress bar -->
      <div class="scroll-progress" aria-hidden="true"></div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider"></div>

    <!-- Estadísticas -->
    <section class="stats-section py-4">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-number" data-target="23">0</span>
            <span class="stat-label">Años formando atletas</span>
            <div class="stat-flash"></div>
          </div>
          <div class="stat-item">
            <span class="stat-number" data-target="400" data-prefix="+">+0</span>
            <span class="stat-label">Alumnos entrenados</span>
            <div class="stat-flash"></div>
          </div>
          <div class="stat-item">
            <span class="stat-number">2007</span>
            <span class="stat-label">Fundación del club</span>
            <div class="stat-flash"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider dark"></div>

    <!-- Filosofía del Club -->
    <section class="filosofia py-5">
      <div class="container">
        <h2 class="text-center mb-3">Un club, una familia y una pasión</h2>
        <p class="filosofia-intro">Somos más que un gimnasio. En Club K-1 Andorra creamos comunidad a través del deporte de contacto, trabajando disciplina, técnica y respeto. Aquí entrenan principiantes, aficionados y competidores, todos compartiendo una misma pasión: la lucha.</p>

        <div class="valores-grid">
          <div class="valor-card">
            <div class="valor-icon">🙏</div>
            <h3>Respeto</h3>
          </div>
          <div class="valor-card">
            <div class="valor-icon">⚡</div>
            <h3>Disciplina</h3>
          </div>
          <div class="valor-card">
            <div class="valor-icon">🤝</div>
            <h3>Humildad</h3>
          </div>
          <div class="valor-card">
            <div class="valor-icon">💪</div>
            <h3>Esfuerzo</h3>
          </div>
          <div class="valor-card">
            <div class="valor-icon">🔥</div>
            <h3>Superación personal</h3>
          </div>
        </div>
      </div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider dark"></div>

    <!-- Disciplinas -->
    <section class="disciplinas py-5">
      <div class="container">
        <h2 class="text-center mb-3">¿En qué quieres entrenar?</h2>
        <p class="section-intro">Ofrecemos varias disciplinas para que puedas elegir según tus objetivos físicos, técnicos o deportivos.</p>

        <div class="cards-grid">
          <div class="card discipline-card">
            <div class="card-image">
              <Image src={boxingImg} alt="Boxeo en Andorra para todos los niveles" width={600} height={400} />
            </div>
            <div class="card-content">
              <h3>Boxeo</h3>
              <p>Entrenamientos técnicos y físicos centrados en los puños, la defensa y la estrategia.</p>
              <a href="/disciplinas/boxeo/" class="btn outline mt-2">Ver Boxeo</a>
            </div>
          </div>

          <div class="card discipline-card">
            <div class="card-image">
              <Image src={kickImg} alt="Kickboxing en Andorra" width={600} height={400} />
            </div>
            <div class="card-content">
              <h3>Kickboxing</h3>
              <p>Disciplina dinámica que mezcla puños y piernas con intensidad y control.</p>
              <a href="/disciplinas/kickboxing/" class="btn outline mt-2">Ver Kickboxing</a>
            </div>
          </div>

          <div class="card discipline-card">
            <div class="card-image">
              <Image src={muaythaiImg} alt="Muay Thai en Andorra" width={600} height={400} />
            </div>
            <div class="card-content">
              <h3>Muay Thai</h3>
              <p>Arte marcial tradicional conocido como "el arte de las ocho armas": puños, piernas, codos y rodillas.</p>
              <a href="/disciplinas/muay-thai/" class="btn outline mt-2">Ver Muay Thai</a>
            </div>
          </div>

          <div class="card discipline-card personal-training">
            <div class="card-content-full">
              <h3>Clases Privadas</h3>
              <p>Entrenamientos individuales o en grupos reducidos adaptados a tus objetivos.</p>
              <a href="/contacto/" class="btn mt-2">Ver Clases Privadas</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider dark"></div>

    <!-- Entrenador -->
    <section class="club py-5">
      <div class="container">
        <div class="club-grid">
          <div class="club-image">
            <Image src={trainerImg} alt="Alfred Freddy Calero - Entrenador de boxeo, kickboxing y muay thai en Andorra" width={500} height={500} class="trainer-img" />
          </div>
          <div class="club-content">
            <h2>Entrena con Alfred "Freddy" Calero</h2>
            <p>Entrenador con más de 30 años de experiencia en deportes de contacto y excompetidor con títulos nacionales e internacionales. Su labor actual se centra en formar alumnos de todas las edades y niveles.</p>
            <a href="/sobre-mi/" class="btn mt-2">Ver más sobre el entrenador</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider"></div>

    <!-- Beneficios -->
    <section class="beneficios py-5">
      <div class="container">
        <h2 class="text-center mb-3">Beneficios de entrenar con nosotros</h2>
        <div class="beneficios-grid">
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Mejora cardiovascular</span>
          </div>
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Coordinación y equilibrio</span>
          </div>
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Fuerza y resistencia</span>
          </div>
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Confianza y seguridad personal</span>
          </div>
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Gestión del estrés</span>
          </div>
          <div class="beneficio-item">
            <span class="beneficio-check">✔</span>
            <span>Cultura deportiva y disciplina</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Separador decorativo -->
    <div class="section-divider dark"></div>

    <!-- Testimonios - Rounds del Ring -->
    <section class="testimonios py-5">
      <div class="container">
        <h2 class="text-center mb-3">Lo que dicen nuestros alumnos</h2>

        <div class="testimonios-ring">
          <div class="ring-center">
            <svg class="ring-lines" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
              <circle cx="200" cy="200" r="180" fill="none" stroke="rgba(225, 6, 0, 0.1)" stroke-width="1"/>
              <circle cx="200" cy="200" r="120" fill="none" stroke="rgba(205, 164, 52, 0.1)" stroke-width="1"/>
            </svg>
          </div>

          <div class="testimonios-grid">
            <div class="card testimonial" data-round="1">
              <div class="round-badge">ROUND 1</div>
              <div class="testimonial-avatar">
                <Image src={testimonio1Img} alt="Rosa Maria Soriano Vega" width={80} height={80} />
              </div>
              <p>"Nuestro hijo empezó con 10 añitos y ahora ya con 15, en plena adolescencia, vemos y corroboramos que aparte de aprender las técnicas de boxeo, kick boxing... Aprenden valores, y sobretodo humildad, que a veces se pasan por alto en otros gyms. Aquí la verdad que de esto van sobraos."</p>
              <cite>— Rosa Maria Soriano Vega</cite>
            </div>

            <div class="card testimonial" data-round="2">
              <div class="round-badge">ROUND 2</div>
              <div class="testimonial-avatar">
                <Image src={testimonio2Img} alt="Xavier T.M" width={80} height={80} />
              </div>
              <p>"Gimnasio tradicional con buen ambiente y un equipo de entrenamiento de alta calidad. El entrenador tiene mucha experiencia y sabe transmitirla y motivar a la gente. Nosotros vamos toda la familia y encantados!!"</p>
              <cite>— Xavier T.M</cite>
            </div>

            <div class="card testimonial" data-round="3">
              <div class="round-badge">ROUND 3</div>
              <div class="testimonial-avatar">
                <Image src={testimonio3Img} alt="Fuad Chouni" width={80} height={80} />
              </div>
              <p>"Sin ninguna duda el mejor Club de Boxeo y Muay Thai de Andorra, entrenar con un excampeón de Europa y España, como Freddy uno aprende muchísimo y marca la diferencia, de todo lo que he aprendido le estaré siempre agradecido."</p>
              <cite>— Fuad Chouni</cite>
            </div>

            <div class="card testimonial" data-round="4">
              <div class="round-badge">ROUND 4</div>
              <div class="testimonial-avatar">
                <Image src={testimonio2Img} alt="Jacobo Peña" width={80} height={80} />
              </div>
              <p>"El mejor entrenador de Andorra con diferencia, muy buen ambiente y profesionalidad, mis dieces."</p>
              <cite>— Jacobo Peña</cite>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Final con Formulario -->
    <section class="cta-final py-5">
      <div class="container">
        <div class="contacto-card">
          <div class="contacto-header">
            <h2>Tu primera clase te está esperando</h2>
            <p>Completa el formulario y te contactamos para reservar tu clase de prueba sin compromiso</p>
          </div>
          <form class="contacto-form" id="contactForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div class="form-row">
              <div class="form-group">
                <input type="text" name="nombre" placeholder="Nombre *" required>
              </div>
              <div class="form-group">
                <input type="email" name="email" placeholder="Email *" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <input type="tel" name="telefono" placeholder="Teléfono *" required>
              </div>
              <div class="form-group">
                <select name="disciplina" required>
                  <option value="">Disciplina de interés *</option>
                  <option value="boxeo">Boxeo</option>
                  <option value="kickboxing">Kickboxing</option>
                  <option value="muaythai">Muay Thai</option>
                  <option value="nose">No estoy seguro/a</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <textarea name="mensaje" placeholder="Mensaje (opcional)" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-submit">
              Solicitar Clase Gratuita
            </button>
            <p class="form-note">* Campos obligatorios. No compartimos tu información.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    margin-top: 0;
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100vh;
    padding-top: 130px; /* compensa el header fijo (90px logo + 40px padding) */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .hero {
      padding-top: 105px; /* 65px logo + 40px padding */
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: 90px; /* 52px logo + 38px padding */
    }
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/src/assets/images/COPIA-SLIDER-scaled.jpeg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    filter: grayscale(30%) brightness(0.75);
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(11, 13, 15, 0.45), rgba(11, 13, 15, 0.65));
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 2rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
    animation: fadeInUp 1s ease-out;
  }

  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: 1rem;
    color: var(--gold);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    animation: fadeInUp 1s ease-out 0.2s both;
    font-weight: 600;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
    color: var(--fg);
    font-style: italic;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    animation: fadeInUp 1s ease-out 0.3s both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeInUp 1s ease-out 0.5s both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 1200px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .discipline-card {
    padding: 0;
    overflow: hidden;
    position: relative;
  }

  .discipline-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 0;
    background: linear-gradient(180deg, var(--accent), var(--gold));
    transition: height 0.4s ease;
    z-index: 10;
  }

  .discipline-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width 0.4s ease;
    z-index: 10;
  }

  .discipline-card:hover::before {
    height: 100%;
  }

  .discipline-card:hover::after {
    width: 40px;
  }

  .card-image {
    position: relative;
    overflow: hidden;
    height: 220px;
  }

  .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(11, 13, 15, 0.8) 100%);
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .discipline-card:hover .card-image::after {
    opacity: 0.3;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(50%) brightness(0.8);
    transition: all 0.5s ease;
  }

  .discipline-card:hover .card-image img {
    filter: grayscale(0%) brightness(1);
    transform: scale(1.08);
  }

  .card-content {
    padding: 1.75rem;
    position: relative;
  }

  .card-content h3 {
    position: relative;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .card-content h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .discipline-card:hover .card-content h3::after {
    width: 50px;
  }

  /* Personal Training Card */
  .personal-training {
    background: linear-gradient(135deg, var(--accent) 0%, rgba(225, 6, 0, 0.8) 100%);
    border: 2px solid var(--gold);
    box-shadow:
      0 0 30px rgba(225, 6, 0, 0.4),
      0 0 60px rgba(205, 164, 52, 0.2),
      inset 0 0 60px rgba(205, 164, 52, 0.1);
    position: relative;
    overflow: visible;
  }

  .personal-training::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    width: 50px;
    height: 50px;
    border-top: 3px solid var(--gold);
    border-left: 3px solid var(--gold);
    opacity: 0.8;
  }

  .personal-training::after {
    content: '';
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 50px;
    height: 50px;
    border-bottom: 3px solid var(--gold);
    border-right: 3px solid var(--gold);
    opacity: 0.8;
  }

  .personal-training:hover {
    box-shadow:
      0 0 40px rgba(225, 6, 0, 0.6),
      0 0 80px rgba(205, 164, 52, 0.3),
      inset 0 0 80px rgba(205, 164, 52, 0.15);
    transform: translateY(-6px) scale(1.02);
  }

  .card-content-full {
    padding: 2.5rem 2rem;
    text-align: center;
    position: relative;
  }

  .personal-training h3 {
    color: var(--fg);
    font-size: 1.9rem;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.05em;
  }

  .personal-training p {
    color: rgba(246, 247, 249, 0.95);
    margin-bottom: 0.85rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .personal-training .highlight {
    color: var(--gold);
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 0 15px rgba(205, 164, 52, 0.5);
    margin-top: 1rem;
  }

  /* Club */
  .club {
    background: var(--card);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .club::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(225, 6, 0, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .club-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .club-image {
    position: relative;
  }

  .club-image::before {
    content: '';
    position: absolute;
    top: -20px;
    left: -20px;
    width: 80px;
    height: 80px;
    border: 2px solid var(--gold);
    opacity: 0.3;
    z-index: -1;
  }

  .club-image::after {
    content: '';
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 80px;
    height: 80px;
    border: 2px solid var(--accent);
    opacity: 0.3;
    z-index: -1;
  }

  .club-image :global(.trainer-img) {
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(225, 6, 0, 0.3);
    border: 2px solid var(--gold);
    filter: grayscale(20%);
    transition: all 0.4s ease;
  }

  .club-image:hover :global(.trainer-img) {
    filter: grayscale(0%);
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(225, 6, 0, 0.5);
  }

  .club-content h2 {
    color: var(--accent);
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 8px rgba(225, 6, 0, 0.3);
  }

  .club-year {
    color: var(--gold);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .club-content p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* Testimonios */
  .testimonios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem 3rem;
    margin-top: 3rem;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .testimonios-grid {
      grid-template-columns: 1fr;
      gap: 3rem 2rem;
    }
  }

  .testimonial {
    text-align: center;
    position: relative;
    padding-top: 3rem;
  }

  .testimonial::before {
    content: '❝';
    position: absolute;
