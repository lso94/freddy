---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const title = 'Galería | Club K1 Andorra';
const description = 'Descubre nuestra galería de fotos y vídeos de entrenamientos y competiciones en Andorra.';
---

<BaseLayout title={title} description={description} canonical="https://freddyboxing.com/galeria/">
  <Header />
  <WhatsAppButton />

  <main class="coming-soon-page">
    <section class="coming-soon-hero">
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <h1>GALERÍA</h1>
        <p class="coming-soon-text">PRÓXIMAMENTE</p>
        <p class="coming-soon-description">Estamos preparando nuestra galería de fotos y vídeos.</p>
        <p class="coming-soon-description">Mientras tanto, contáctanos por WhatsApp para más información.</p>
        <div class="cta-buttons">
          <a href="https://api.whatsapp.com/send?phone=376331785&text=Hola%20Freddy%2C%20quiero%20información." class="btn" target="_blank" rel="noopener noreferrer">
            Contactar por WhatsApp
          </a>
          <a href="/" class="btn outline">Volver al inicio</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .coming-soon-page {
    background: var(--bg);
  }

  .coming-soon-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(225, 6, 0, 0.2) 0%, rgba(11, 13, 15, 0.95) 50%, rgba(205, 164, 52, 0.2) 100%);
    overflow: hidden;
    margin-top: 80px;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 50%, rgba(225, 6, 0, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 70% 50%, rgba(205, 164, 52, 0.1) 0%, transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
  }

  .coming-soon-hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--fg);
    margin-bottom: 2rem;
    text-shadow: 0 4px 20px rgba(225, 6, 0, 0.5);
  }

  .coming-soon-text {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--gold);
    margin-bottom: 2rem;
    letter-spacing: 0.2em;
    text-shadow: 0 2px 10px rgba(205, 164, 52, 0.5);
  }

  .coming-soon-description {
    font-size: 1.25rem;
    color: rgba(246, 247, 249, 0.8);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
    }
  }
</style>
